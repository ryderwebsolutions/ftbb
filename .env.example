# Stripe webhook (Dashboard → Developers → Webhooks → your endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe secret key (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_...

# Resend (resend.com → API Keys)
RESEND_API_KEY=re_...

# Required: must be a verified sender on your Resend domain. Verify "send.ftbb.ie"
# (a subdomain) rather than the root ftbb.ie to avoid changing Google Workspace MX records.
FROM_EMAIL=FTBB <orders@send.ftbb.ie>

# Falls back to https://ftbb.ie if unset
SITE_URL=https://ftbb.ie

# Customer support address shown in the confirmation email
SUPPORT_EMAIL=info@ftbb.ie
