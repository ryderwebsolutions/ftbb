# Stripe webhook (Dashboard → Developers → Webhooks → your endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe secret key (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_...

# Resend (resend.com → API Keys)
RESEND_API_KEY=re_...

# Must be a verified sender on your Resend domain. Verify "send.ftbb.ie" (a
# subdomain) in Resend rather than the root ftbb.ie, so Resend's bounce-handling
# MX record doesn't collide with the existing Google Workspace MX records on
# the root domain. Falls back to onboarding@resend.dev (Resend's shared test
# sender) if unset.
FROM_EMAIL=FTBB <orders@send.ftbb.ie>

# Falls back to https://ftbb.ie if unset
SITE_URL=https://ftbb.ie
